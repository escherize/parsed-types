// The life of an order: a draft, a parse, a parsed value, a sink.
style dim    text: (color: theme-muted)
style proof  fill: theme-primary-subtle  border: theme-primary
style bad    border: theme-secondary
style note   text: (size: small, color: theme-muted)

node draft   "OrderDraft / [dim]built with pt/draft[/dim]"
node order   "Order / [dim]carries the proof[/dim]"   right of draft  gap: wide  style: proof
node sink    "place-order! / [dim]calls pt/parsed[/dim]"  right of order  gap: wide
node lines   "OrderLines / [dim]from pt/parse-all[/dim]"  above draft  gap: wide
node invalid "throws ::invalid / [dim]every failure, by check[/dim]"  below order  gap: wide  style: bad
node forged  "(Order. ...) by hand / [dim]no proof[/dim]"  below sink  level with invalid  style: bad

edge draft -> order    "pt/parse"       from: right  to: left
edge order -> sink     from: right  to: left
edge draft -> invalid  "a check fails"  from: bottom  to: left
edge order -> draft    "pt/draft-of"    from: top  to: top
edge lines -> draft    "in :lines"      from: bottom  to: top
edge forged -> sink    "refused"        from: top  to: bottom  line: (pattern: dashed)
